{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Line & Light",
  "version": "0.1.0",
  "identifier": "com.lineandlight.viewer",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/image-viewer-for-artist/browser"
  },
  "app": {
    "windows": [
      { "title": "Line & Light", "width": 1440, "height": 900, "minWidth": 920, "minHeight": 640, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
